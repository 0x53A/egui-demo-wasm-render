+
+    #[test]
+    fn external_metrics_scale_and_ignore_invalid_values() {
+        let mut fonts = FontsImpl::new(TextOptions::default(), FontDefinitions::empty())
+            .with_glyph_rasterizer(
+                GlyphRasterizer::new("invalid", |_| None)
+                    .with_priority(FontPriority::Highest)
